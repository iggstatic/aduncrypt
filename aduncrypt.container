[Unit]
Description=AdUnCrypt DNS Stack
Documentation=https://github.com/iggstatic/aduncrypt
After=network-online.target
Wants=network-online.target

[Container]
Image=ghcr.io/iggstatic/aduncrypt:latest
ContainerName=aduncrypt
AutoUpdate=registry

Volume=%h/aduncrypt/adguard/opt-adguard-work:/opt/adguardhome/work
Volume=%h/aduncrypt/adguard/opt-adguard-conf:/opt/adguardhome/conf
Volume=%h/aduncrypt/unbound/unbound.conf:/opt/unbound/unbound.conf
Volume=%h/aduncrypt/dnscrypt:/opt/dnscrypt
Volume=aduncrypt-unbound:/var/lib/unbound
Volume=aduncrypt-dnscrypt-cache:/var/cache/dnscrypt-proxy

HealthCmd=sh /opt/scripts/healthcheck.sh
HealthInterval=30s
HealthTimeout=15s
HealthStartPeriod=30s
HealthRetries=3
HealthOnFailure=kill

# Every service runs as its own unprivileged user. Drop every capability and
# add back only what the entrypoint needs; NET_BIND_SERVICE is passed on to
# AdGuard Home for ports 53 and 80.
DropCapability=ALL
AddCapability=NET_BIND_SERVICE CHOWN FOWNER SETUID SETGID KILL DAC_OVERRIDE
# Add NET_RAW above if you enable the AdGuard Home DHCP server
NoNewPrivileges=true
# Everything the services write lives in the volumes above; the rest of the
# image is read-only (with tmpfs on /tmp, /var/tmp and /run)
ReadOnly=true

PublishPort=53:53/tcp
PublishPort=53:53/udp
PublishPort=80:80/tcp

[Service]
Restart=always
TimeoutStartSec=900

[Install]
WantedBy=default.target
